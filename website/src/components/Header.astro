---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import DownloadLink from './DownloadLink.astro';
import { copies, languageNames } from '../copy';
import { homeAnchor, links, localePath, pageUrl, type Lang } from '../site';

interface Props {
  lang: Lang;
  path: string;
  over?: boolean;
}

const { lang, path, over = false } = Astro.props;
const copy = copies[lang];
const other: Lang = lang === 'en' ? 'zh' : 'en';
const home = pageUrl(lang, 'home');
const nav = [
  { href: homeAnchor(lang, 'how'), label: copy.nav.how },
  { href: homeAnchor(lang, 'features'), label: copy.nav.features },
  { href: homeAnchor(lang, 'compatibility'), label: copy.nav.compatibility },
];
---

<header class:list={['header', over && 'header--over']} data-header>
  <div class="container header__inner">
    <a class="brand" href={home} aria-label="Hando">
      <Logo size={29} />
    </a>

    <nav id="site-nav" class="header__nav" aria-label={copy.nav.primary}>
      {nav.map((item) => (
        <a class="header__link" href={item.href}>{item.label}</a>
      ))}
      <a
        class="header__link header__link--page"
        href={links.releases}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.nav.download}
        <Icon name="external" size={13} />
      </a>
      <a
        class="header__link header__link--page"
        href={links.repo}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.common.github}
        <Icon name="external" size={13} />
      </a>
      <div class="header__mobile-cta">
        <DownloadLink lang={lang} />
      </div>
    </nav>

    <div class="header__actions">
      <a
        class="icon-button header__github"
        href={links.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={copy.common.github}
        title={copy.common.github}
      >
        <Icon name="github" size={18} />
      </a>
      <a
        class="icon-button header__language"
        href={localePath(other, path)}
        hreflang={other === 'zh' ? 'zh-CN' : 'en'}
        lang={other === 'zh' ? 'zh-CN' : 'en'}
        data-lang={other}
        aria-label={`${copy.nav.language}: ${languageNames[other]}`}
      >
        <Icon name="globe" size={17} />
        <span>{languageNames[other]}</span>
      </a>
      <button
        type="button"
        class="icon-button theme-switch"
        data-theme-switch
        data-label-light={copy.nav.themeLight}
        data-label-dark={copy.nav.themeDark}
        aria-label={copy.nav.themeLight}
        title={copy.nav.themeLight}
      >
        <Icon name="moon" size={17} class="theme-switch__to-dark" />
        <Icon name="sun" size={17} class="theme-switch__to-light" />
      </button>
      <a
        class="btn btn--primary header__cta"
        href={links.releases}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="download" size={16} />
        {copy.nav.download}
      </a>
      <button
        type="button"
        class="icon-button header__burger"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={copy.nav.menu}
        data-open-label={copy.nav.menu}
        data-close-label={copy.nav.close}
      >
        <Icon name="menu" size={19} class="header__burger-open" />
        <Icon name="close" size={19} class="header__burger-close" />
      </button>
    </div>
  </div>
</header>

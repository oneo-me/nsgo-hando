---
// A small line-icon set, in the app's stroke. Brand marks are filled and
// the rest inherit the current color.
export type IconName =
  | 'android'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'check'
  | 'check-circle'
  | 'chevron-right'
  | 'clock'
  | 'cloud-off'
  | 'close'
  | 'download'
  | 'external'
  | 'eye-off'
  | 'file'
  | 'folder'
  | 'github'
  | 'globe'
  | 'hash'
  | 'laptop'
  | 'link'
  | 'lock'
  | 'menu'
  | 'message'
  | 'moon'
  | 'refresh'
  | 'send'
  | 'settings'
  | 'shield'
  | 'smartphone'
  | 'star'
  | 'star-filled'
  | 'sun'
  | 'terminal'
  | 'wifi'
  | 'windows';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 20, stroke = 1.7, class: className } = Astro.props;

const fillIcons = new Set<IconName>(['github', 'windows', 'star-filled']);


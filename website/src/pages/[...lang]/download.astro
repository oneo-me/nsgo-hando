---
import { Image } from 'astro:assets';
import DownloadLink from '../../components/DownloadLink.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { copies } from '../../copy';
import { langOf, langPaths, links, platforms, type PlatformId } from '../../site';
import icon from '../../assets/icon.png';

export const getStaticPaths = () => langPaths();

const lang = langOf(Astro.params.lang);
const copy = copies[lang];
const d = copy.download;

const platformIcon: Record<PlatformId, 'laptop' | 'windows' | 'terminal' | 'android' | 'smartphone'> = {
  macos: 'laptop',
  windows: 'windows',
  linux: 'terminal',
  android: 'android',
  ios: 'smartphone',
};
---

<Layout
  lang={lang}
  page="download"
  path="download/"
  title={d.title}
  description={d.description}
>
  <section class="page-hero page-hero--center">
    <div class="container page-hero__inner">
      <Image
        src={icon}
        alt=""
        width={82}
        height={82}
        class="page-hero__icon"
        loading="eager"
      />
      <span class="eyebrow">{d.hero.eyebrow}</span>
      <h1>{d.hero.title}</h1>
      <p class="lead">{d.hero.lead}</p>
      <div class="page-hero__actions">
        <DownloadLink lang={lang} size="large" label={d.hero.latest} />
        <a class="btn btn--ghost btn--large" href={links.allReleases} target="_blank" rel="noopener noreferrer">
          {copy.common.allReleases}
          <Icon name="external" size={14} />
        </a>
      </div>
      <p class="page-hero__note">{d.hero.note}</p>
      <div class="page-hero__platforms">
        {platforms.map((platform) => (
          <span class="page-hero__platform">
            <Icon name={platformIcon[platform.id]} size={13} />
            {platform.name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="platforms">
        {platforms.map((platform) => (
          <a
            class="platform-card"
            href={links.releases}
            target="_blank"
            rel="noopener noreferrer"
            data-platform={platform.id}
          >
            <div class="platform-card__top">
              <span class="platform-card__icon">
                <Icon name={platformIcon[platform.id]} size={18} />
              </span>
              <span class="platform-card__you">{d.you}</span>
            </div>
            <h2>{platform.name}</h2>
            <span class="platform-card__format">{d.platforms[platform.id].format}</span>
            <p>{d.platforms[platform.id].note}</p>
            <span class="platform-card__link">
              {d.open}
              <Icon name="arrow-up-right" size={13} />
            </span>
          </a>
        ))}
      </div>

      <div class="after">
        <div class="after__head" data-reveal>
          <span class="eyebrow">{copy.nav.download}</span>
          <h2>{d.after.title}</h2>
          <p class="lead">{d.after.lead}</p>
        </div>
        <div class="install" data-reveal>
          {platforms.map((platform) => (
            <div class="install__row">
              <span class="install__platform">
                <Icon name={platformIcon[platform.id]} size={15} />
                {platform.name}
              </span>
              <p>{d.after.steps[platform.id]}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="info-grid">
        <section class="info-card" data-reveal>
          <h2>{d.needs.title}</h2>
          <ul class="checklist">
            {d.needs.items.map((item) => (
              <li><Icon name="check" size={14} />{item}</li>
            ))}
          </ul>
        </section>

        <section class="info-card" data-reveal>
          <h2>{d.verify.title}</h2>
          <p>{d.verify.body}</p>
          <div class="inline-links">
            <a href={links.workflow} target="_blank" rel="noopener noreferrer">
              {d.verify.workflow}
              <Icon name="external" size={12} />
            </a>
            <a href={links.repo} target="_blank" rel="noopener noreferrer">
              {d.verify.source}
              <Icon name="github" size={13} />
            </a>
          </div>
        </section>

        <section class="info-card info-card--wide" data-reveal>
          <h2>{d.build.title}</h2>
          <p>{d.build.body}</p>
          <pre class="code"><code><span class="code__dim">$</span> git clone https://github.com/oneo-me/nsgo-hando.git
<span class="code__dim">$</span> cd nsgo-hando
<span class="code__dim">$</span> go tool nsgo build
<span class="code__dim">$</span> go tool nsgo test</code></pre>
          <p class="info-card__note">{d.build.note}</p>
        </section>
      </div>
    </div>
  </section>
</Layout>
